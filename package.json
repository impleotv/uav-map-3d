{
  "name": "@impleotv-pm/uav-map-3d",
  "version": "0.5.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Framework-neutral Cesium UAV scene renderer with sensor footprints and targets",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/impleotv/uav-map-3d.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.mts",
      "import": "./dist/models.mjs"
    },
    "./orientation": {
      "types": "./dist/orientation.d.mts",
      "import": "./dist/orientation.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/presentation.css"
  },
  "files": [
    "dist",
    "assets",
    "CHANGELOG.md",
    "NOTICE.md",
    "REACT.md",
    "RENDERER.md",
    "HOWTO.md",
    "skills/uav-map-3d"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-support.mjs",
    "typecheck": "npm run build && tsc -p tsconfig.sample.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "sample": "vite --host 127.0.0.1",
    "sample:build": "vite build",
    "sample:preview": "vite preview --host 127.0.0.1",
    "verify:package": "node scripts/verify-package.mjs",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "cesium": "1.145.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cesium": "1.145.0",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "jsdom": "^29.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^21.0.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
